{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ripple",
  "mainBinaryName": "ripple",
  "version": "1.3.0",
  "identifier": "com.weebec.ripple",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Music",
    "publisher": "Weebec",
    "copyright": "Copyright (c) 2026 Weebec",
    "shortDescription": "made for humans, Ripple - audio player.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/": "bin/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
